@model GestorIngresosGastos.Models.Ingreso
@{
    ViewData["Title"] = "Registrar Ingreso";
}

<div class="card shadow mb-4 col-lg-8 mx-auto p-0">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-success">Registrar Nuevo Ingreso</h6>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label>Descripción</label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej. Quincena, Alquiler apartamento..." required />
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Tipo de Ingreso</label>
                    <select asp-for="TipoIngreso" class="form-control" required>
                        <option value="Activo">Ingreso Activo</option>
                        <option value="Pasivo">Ingreso Pasivo</option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>Fuente</label>
                    <input asp-for="Fuente" class="form-control" placeholder="Ej. Salario, Negocio, Renta, Inversiones" required />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Monto (RD$)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="form-group col-md-6">
                    <label>Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-success">Guardar Ingreso</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
