@model GestorIngresosGastos.Models.Gasto
@{
    ViewData["Title"] = "Edita Gasto";
}

<div class="card shadow mb-4 col-lg-8 mx-auto p-0">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Editar Gasto</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label>Descripción</label>
                <input asp-for="Descripcion" class="form-control" required />
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Tipo de Gasto</label>
                    <select asp-for="TipoGasto" class="form-control" required>
                        <option value="Fijo">Gasto Fijo</option>
                        <option value="Variable">Gasto Variable</option>
                    </select>
                </div>
                <div class="form-group col-md-6">
                    <label>Categoría</label>
                    <input asp-for="Categoria" class="form-control" required />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>Monto (RD$)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="form-group col-md-6">
                    <label>Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Actualizar Gasto</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
