@model GestorIngresosGastos.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Financiero";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Resumen Financiero</h1>
    <span class="text-muted">Bienvenido, <strong>@ViewBag.UsuarioNombre</strong></span>
</div>

<!-- Tarjetas de KPIs -->
<div class="row">
    <!-- Total Ingresos -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Ingresos</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">RD$ @Model.TotalIngresos.ToString("N2")</div>
                        <small class="text-muted">Activos: RD$ @Model.IngresosActivos.ToString("N2") | Pasivos: RD$ @Model.IngresosPasivos.ToString("N2")</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-arrow-circle-up fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Gastos -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Total Gastos</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">RD$ @Model.TotalGastos.ToString("N2")</div>
                        <small class="text-muted">Fijos: RD$ @Model.GastosFijos.ToString("N2") | Variables: RD$ @Model.GastosVariables.ToString("N2")</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-arrow-circle-down fa-2x text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Balance Disponible -->
    <div class="col-xl-4 col-md-12 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Balance Disponible</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">RD$ @Model.BalanceDisponible.ToString("N2")</div>
                        <small class="text-muted">Ingresos netos menos gastos</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-balance-scale fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Últimos Movimientos -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Últimos Movimientos Registrados</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Tipo</th>
                        <th>Clasificación</th>
                        <th>Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.UltimosMovimientos)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.Descripcion</td>
                            <td>
                                @if (item.Tipo == "Ingreso")
                                {
                                    <span class="badge badge-success">Ingreso</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Gasto</span>
                                }
                            </td>
                            <td>@item.Clasificacion</td>
                            <td class="font-weight-bold">RD$ @item.Monto.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
